# Copy this file to `.env` and fill in your own Supabase project values.
# These are safe to expose in the browser (the publishable key is public by design).
# NEVER put the Supabase `sb_secret_...` / service_role key in here or in any VITE_ var.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
